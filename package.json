{
  "name": "idcraft-studio",
  "productName": "IDCraft Studio",
  "version": "1.1.0",
  "description": "IDCraft Studio - ID card designer, bulk generator and printer",
  "author": "IDCraft Studio",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "app:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "app:start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:win-portable": "npm run build && electron-builder --win portable --x64 --publish never",
    "keygen": "node scripts/keygen.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "dexie": "^4.0.9",
    "dexie-react-hooks": "^1.1.7",
    "jsbarcode": "^3.11.6",
    "jspdf": "^2.5.2",
    "konva": "^9.3.16",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.idcraft.studio",
    "productName": "IDCraft Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32",
            "arm64"
          ]
        }
      ],
      "artifactName": "IDCraft-Studio-Setup.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "IDCraft Studio",
      "uninstallDisplayName": "IDCraft Studio",
      "deleteAppDataOnUninstall": false
    },
    "copyright": "Copyright © 2026 IDCraft Studio",
    "asar": true,
    "afterPack": "scripts/afterPack.cjs"
  }
}
